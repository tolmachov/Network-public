/ip firewall address-list
:foreach i in=[/ip firewall address-list find list=bypass-vpn comment~"^#auto"] do={ /ip firewall address-list set $i comment=("#stale " . [/ip firewall address-list get $i comment]) }
:foreach i in=[/ip firewall address-list find list=force-vpn comment~"^#auto"] do={ /ip firewall address-list set $i comment=("#stale " . [/ip firewall address-list get $i comment]) }
:local U do={ :do { /ip firewall address-list add address=$1 list=$2 comment=$3 } on-error={ /ip firewall address-list set [/ip firewall address-list find list=$2 address=$1] comment=$3 } }
